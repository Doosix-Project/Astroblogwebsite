---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/blog';

export interface Props {
  post: CollectionEntry<'blog'>;
  preloadImage?: boolean;
}

const { post, preloadImage = false } = Astro.props;

const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  'AI & LLMs': { bg: 'bg-violet-50', text: 'text-violet-700', border: 'border-violet-200' },
  'DevOps & Cloud': { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  'Open Source': { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  'Architecture': { bg: 'bg-amber-50', text: 'text-amber-700', border: 'border-amber-200' },
};

const badgeStyle = categoryColors[post.data.category] || {
  bg: 'bg-slate-50',
  text: 'text-slate-700',
  border: 'border-slate-200',
};
---

<article class="bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-md hover:border-blue-200 transition-all duration-200 flex flex-col overflow-hidden group">
  <!-- Card Media -->
  <a href={`/blog/${post.id}`} class="relative block aspect-[16/9] overflow-hidden bg-slate-100">
    <img
      src={post.data.heroImage || '/images/og-default.svg'}
      alt={post.data.title}
      width="640"
      height="360"
      loading={preloadImage ? 'eager' : 'lazy'}
      class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
    />
    <div class="absolute top-3 left-3">
      <span class={`px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider rounded-full border shadow-xs ${badgeStyle.bg} ${badgeStyle.text} ${badgeStyle.border}`}>
        {post.data.category}
      </span>
    </div>
  </a>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta line -->
      <div class="flex items-center gap-2.5 text-xs text-slate-500 mb-2.5">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>•</span>
        <span>{post.data.readingTime}</span>
      </div>

      <!-- Title -->
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
        <a href={`/blog/${post.id}`}>
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="mt-2.5 text-slate-600 text-sm leading-relaxed line-clamp-3">
        {post.data.description}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <img
          src={post.data.authorAvatar}
          alt={post.data.author}
          width="28"
          height="28"
          class="w-7 h-7 rounded-full ring-1 ring-slate-200"
        />
        <span class="text-xs font-semibold text-slate-800">{post.data.author}</span>
      </div>

      <a
        href={`/blog/${post.id}`}
        class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 group-hover:translate-x-0.5 transition-transform"
      >
        Read
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
