---
import { getCategoriesWithCount, getTagsWithCount } from '../utils/blog';

export interface Props {
  showAuthor?: boolean;
}

const { showAuthor = true } = Astro.props;

const categories = await getCategoriesWithCount();
const tags = await getTagsWithCount();
---

<aside class="space-y-8" aria-label="Blog Sidebar">
  
  <!-- Widget 1: Author Card -->
  {showAuthor && (
    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs">
      <div class="flex items-center gap-4">
        <img
          src="/avatar.svg"
          alt="Alex Rivera"
          width="56"
          height="56"
          class="w-14 h-14 rounded-full ring-2 ring-blue-100"
        />
        <div>
          <h3 class="font-bold text-base text-slate-900">Alex Rivera</h3>
          <p class="text-xs text-blue-600 font-medium">Staff Platform &amp; AI Engineer</p>
        </div>
      </div>
      <p class="mt-3.5 text-xs text-slate-600 leading-relaxed">
        Writing about agentic AI architectures, Kubernetes continuous delivery, and self-hosted infrastructure on Coolify.
      </p>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
        <a href="/about" class="text-blue-600 hover:text-blue-700 font-semibold inline-flex items-center gap-1">
          Learn more
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/rss.xml" class="text-amber-600 hover:text-amber-700 font-medium">
          RSS Feed
        </a>
      </div>
    </div>
  )}

  <!-- Widget 2: Categories with Counts -->
  <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Categories</h3>
      <span class="text-[11px] text-slate-400 font-mono">{categories.length} Topics</span>
    </div>
    <ul class="mt-4 space-y-2.5">
      {categories.map((cat) => (
        <li>
          <a
            href={`/category/${cat.slug}`}
            class="flex items-center justify-between group py-1 text-sm text-slate-700 hover:text-blue-600 transition-colors"
          >
            <span class="font-medium group-hover:translate-x-0.5 transition-transform">
              {cat.name}
            </span>
            <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-slate-100 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors">
              {cat.count}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Widget 3: Newsletter Sign-up Box -->
  <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-2xl p-6 text-white shadow-sm">
    <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center text-white mb-3">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </div>
    <h3 class="font-bold text-lg leading-snug">Engineering Dispatch</h3>
    <p class="mt-1.5 text-xs text-blue-100 leading-relaxed">
      Weekly curated insights on AI agents, Kubernetes, and open-source tools.
    </p>
    <form
      id="sidebar-nl-form"
      class="mt-4 space-y-2.5"
    >
      <input
        type="email"
        required
        placeholder="alex@domain.com"
        aria-label="Email address for sidebar newsletter"
        class="w-full px-3.5 py-2 text-xs bg-white text-slate-900 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white"
      />
      <button
        type="submit"
        class="w-full py-2 px-3 text-xs font-bold text-blue-900 bg-white hover:bg-blue-50 rounded-lg transition-colors"
      >
        Subscribe Free
      </button>
      <p id="sidebar-nl-msg" class="hidden text-xs text-emerald-200 font-medium pt-1">
        ✔ Check your inbox to confirm subscription!
      </p>
    </form>
  </div>

  <!-- Widget 4: Trending Tags Cloud -->
  <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Popular Tags</h3>
    </div>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a
          href={`/tag/${tag.slug}`}
          class="px-2.5 py-1 text-xs font-medium bg-slate-50 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg border border-slate-200/80 transition-colors"
        >
          #{tag.name}
          <span class="text-[10px] text-slate-400 ml-0.5">({tag.count})</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Widget 5: Coolify & Speed Badge -->
  <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 text-center">
    <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 shadow-xs mb-2">
      <span class="text-base font-bold text-slate-800">⚡</span>
    </div>
    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">100% Static &amp; Coolify Ready</h4>
    <p class="mt-1 text-[11px] text-slate-500 leading-normal">
      Multi-stage Dockerfile &amp; Nginx Alpine ready for immediate deployment.
    </p>
    <a
      href="/blog/coolify-self-hosting-modern-infrastructure"
      class="mt-3 inline-block text-xs font-bold text-blue-600 hover:underline"
    >
      Read Setup Instructions →
    </a>
  </div>

</aside>

<script is:inline>
  const sidebarForm = document.getElementById('sidebar-nl-form');
  if (sidebarForm) {
    sidebarForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = document.getElementById('sidebar-nl-msg');
      if (msg) msg.classList.remove('hidden');
    });
  }
</script>
