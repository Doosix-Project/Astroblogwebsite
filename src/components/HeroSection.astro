---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/blog';

export interface Props {
  featuredPost: CollectionEntry<'blog'>;
  secondaryPost?: CollectionEntry<'blog'>;
}

const { featuredPost, secondaryPost } = Astro.props;
---

<section class="relative pt-6 pb-12 border-b border-slate-200/80 bg-gradient-to-b from-white to-slate-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Headline & Tagline -->
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        Engineering Journal &amp; Production Architecture
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        The Modern Blueprint for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600">AI &amp; DevOps</span>
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
        Deep dives on agentic LLMs, Kubernetes GitOps, self-hosted infrastructure with Coolify, and open-source tooling.
      </p>
    </div>

    <!-- Hero Section Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Main Featured Spotlight Post (8 Columns on Large Screens) -->
      <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-blue-200 transition-all flex flex-col overflow-hidden group">
        <a href={`/blog/${featuredPost.id}`} class="relative block aspect-[16/9] sm:aspect-[21/9] overflow-hidden bg-slate-100">
          <img
            src={featuredPost.data.heroImage || '/images/og-default.svg'}
            alt={featuredPost.data.title}
            width="800"
            height="450"
            loading="eager"
            class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
          />
          <div class="absolute top-4 left-4 flex gap-2">
            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider text-white bg-blue-600 rounded-full shadow-sm">
              {featuredPost.data.heroBadge || 'Featured Spotlight'}
            </span>
            <span class="px-2.5 py-1 text-xs font-semibold text-slate-900 bg-white/90 backdrop-blur-xs rounded-full shadow-xs">
              {featuredPost.data.category}
            </span>
          </div>
        </a>

        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
              <time datetime={featuredPost.data.pubDate.toISOString()}>
                {formatDate(featuredPost.data.pubDate)}
              </time>
              <span>•</span>
              <span class="font-medium text-slate-600">{featuredPost.data.readingTime}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
              <a href={`/blog/${featuredPost.id}`}>
                {featuredPost.data.title}
              </a>
            </h2>

            <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed line-clamp-3">
              {featuredPost.data.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img
                src={featuredPost.data.authorAvatar}
                alt={featuredPost.data.author}
                width="36"
                height="36"
                class="w-9 h-9 rounded-full ring-2 ring-slate-100"
              />
              <div>
                <p class="text-xs font-bold text-slate-900">{featuredPost.data.author}</p>
                <p class="text-[11px] text-slate-500">{featuredPost.data.authorRole}</p>
              </div>
            </div>

            <a
              href={`/blog/${featuredPost.id}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700 group/link"
            >
              Read Full Guide
              <svg class="w-3.5 h-3.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column Grid Cards (4 Columns on Large Screens) -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        
        <!-- Secondary Post Card -->
        {secondaryPost && (
          <div class="flex-1 bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm hover:shadow-md hover:border-blue-200 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 rounded-full border border-indigo-200/60">
                  {secondaryPost.data.category}
                </span>
                <span class="text-xs text-slate-400">{secondaryPost.data.readingTime}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
                <a href={`/blog/${secondaryPost.id}`}>
                  {secondaryPost.data.title}
                </a>
              </h3>
              <p class="mt-2 text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {secondaryPost.data.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[11px] text-slate-400">{formatDate(secondaryPost.data.pubDate)}</span>
              <a href={`/blog/${secondaryPost.id}`} class="text-xs font-semibold text-blue-600 hover:underline">
                Read Story →
              </a>
            </div>
          </div>
        )}

        <!-- Performance / Coolify Ready Metric Card -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-5 text-white shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] uppercase font-bold tracking-wider text-emerald-400">Zero JS Runtime</span>
              <span class="px-2 py-0.5 text-[10px] font-bold bg-emerald-500/20 text-emerald-300 rounded border border-emerald-500/30">
                Lighthouse 100
              </span>
            </div>
            <h4 class="text-base font-bold text-white leading-snug">
              Instant Static Speed + Automated Coolify Hosting
            </h4>
            <p class="mt-2 text-xs text-slate-300 leading-relaxed">
              Served via lightweight Nginx Alpine with Gzip compression and multi-stage Docker builds.
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-mono">TTFB &lt; 20ms</span>
            <a
              href="/blog/zero-cost-high-performance-static-blogs"
              class="text-emerald-400 hover:text-emerald-300 font-semibold"
            >
              See Architecture →
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Quick Filter Category Bar -->
    <div class="mt-8 pt-6 border-t border-slate-200/60 flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-2">Quick Browse:</span>
      <a href="/blog" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white shadow-xs">
        All Posts
      </a>
      <a href="/category/ai-llms" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
        🤖 AI &amp; LLMs
      </a>
      <a href="/category/devops-cloud" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
        ⚡ DevOps &amp; Cloud
      </a>
      <a href="/category/open-source" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
        🌐 Open Source
      </a>
      <a href="/category/architecture" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
        📐 Architecture
      </a>
    </div>

  </div>
</section>
