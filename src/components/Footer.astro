---
const currentYear = new Date().getFullYear();

const categories = [
  { name: 'AI & LLMs', href: '/category/ai-llms' },
  { name: 'DevOps & Cloud', href: '/category/devops-cloud' },
  { name: 'Open Source', href: '/category/open-source' },
  { name: 'Architecture', href: '/category/architecture' },
];

const links = [
  { name: 'All Articles', href: '/blog' },
  { name: 'About Author', href: '/about' },
  { name: 'RSS Feed', href: '/rss.xml' },
  { name: 'Coolify Deployment Guide', href: '/blog/coolify-self-hosting-modern-infrastructure' },
];
---

<footer class="mt-auto bg-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Column 1: Brand Info -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-base">
            DP
          </div>
          <span class="font-bold text-lg text-slate-900 tracking-tight">DevPulse<span class="text-blue-600">.</span></span>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed">
          High-performance engineering publication focusing on Agentic AI, production DevOps, open-source architectures, and self-hosted cloud infrastructure.
        </p>
        <div class="flex items-center gap-3 pt-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            100/100 Lighthouse
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
            Coolify Ready
          </span>
        </div>
      </div>

      <!-- Column 2: Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Topics</h3>
        <ul class="space-y-2 text-sm">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="text-slate-600 hover:text-blue-600 transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Resources -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Resources</h3>
        <ul class="space-y-2 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-blue-600 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Newsletter Box -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Engineering Dispatch</h3>
        <p class="text-xs text-slate-500">
          Get weekly architectural teardowns on AI workflows and Kubernetes deployments. No spam, ever.
        </p>
        <form
          id="footer-nl-form"
          action="/#newsletter"
          method="GET"
          class="space-y-2"
        >
          <div class="flex gap-2">
            <input
              type="email"
              required
              placeholder="you@domain.com"
              aria-label="Email Address for newsletter"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
            />
            <button
              type="submit"
              class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors whitespace-nowrap"
            >
              Join
            </button>
          </div>
          <p id="footer-msg" class="hidden text-xs text-emerald-600 font-medium">
            ✔ Thank you for subscribing to DevPulse!
          </p>
        </form>
      </div>

    </div>

    <!-- Bottom line -->
    <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} DevPulse. Built with Astro Static, Tailwind CSS, &amp; deployed on Coolify.</p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="hover:text-blue-600 transition-colors">RSS Feed</a>
        <a href="/robots.txt" class="hover:text-blue-600 transition-colors">Robots.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-blue-600 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const footerForm = document.getElementById('footer-nl-form');
  if (footerForm) {
    footerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = document.getElementById('footer-msg');
      if (msg) msg.classList.remove('hidden');
    });
  }
</script>
