---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About DevPulse // Technical Publication & Architecture"
  description="Learn about DevPulse's editorial mission, author background, and the 100/100 Lighthouse architecture powering this blog."
  image="/images/og-default.svg"
>
  <div class="bg-white border-b border-slate-200/80 pt-10 pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        Engineering Editorial &amp; Architecture
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Building for Scale, Speed, and Autonomy
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        DevPulse is a dedicated engineering journal delivering deep technical analyses on Agentic AI workflows, Kubernetes GitOps, self-hosted cloud infrastructure, and open-source tooling.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="space-y-12">
      
      <!-- Author Profile Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-xs flex flex-col sm:flex-row items-center sm:items-start gap-6">
        <img
          src="/avatar.svg"
          alt="Alex Rivera"
          width="96"
          height="96"
          class="w-24 h-24 rounded-2xl ring-4 ring-blue-50 shadow-sm"
        />
        <div class="space-y-3 text-center sm:text-left">
          <div>
            <h2 class="text-xl font-bold text-slate-900">Alex Rivera</h2>
            <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Staff Platform &amp; AI Systems Engineer</p>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed">
            Over a decade of experience designing fault-tolerant distributed systems, production Kubernetes clusters, and AI reasoning pipelines. Passionate about empowering engineering teams with open-source sovereignty and self-hosted cloud stacks like Coolify.
          </p>
          <div class="flex flex-wrap gap-2 pt-2 justify-center sm:justify-start">
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 rounded-lg text-slate-700">Kubernetes</span>
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 rounded-lg text-slate-700">Agentic AI</span>
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 rounded-lg text-slate-700">Coolify</span>
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 rounded-lg text-slate-700">Docker</span>
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 rounded-lg text-slate-700">TypeScript</span>
          </div>
        </div>
      </div>

      <!-- Core Pillars -->
      <section class="space-y-4">
        <h3 class="text-2xl font-bold text-slate-900 tracking-tight">Core Focus Areas</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
          
          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-violet-100 text-violet-700 flex items-center justify-center font-bold text-lg">
              🤖
            </div>
            <h4 class="font-bold text-slate-900">Agentic AI &amp; LLMs</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Moving beyond static prompts into multi-agent systems, tool execution sandboxes, and local model inference with Ollama &amp; vLLM.
            </p>
          </div>

          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg">
              ⚡
            </div>
            <h4 class="font-bold text-slate-900">DevOps &amp; Cloud</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Declarative GitOps with ArgoCD, minimal container optimizations, zero-downtime updates, and production observability.
            </p>
          </div>

          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
              🌐
            </div>
            <h4 class="font-bold text-slate-900">Open Source &amp; Self-Hosting</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Reclaiming independence from proprietary cloud monopolies by mastering Coolify, PostgreSQL, and open developer infrastructure.
            </p>
          </div>

        </div>
      </section>

      <!-- Technical Architecture -->
      <section class="bg-white rounded-2xl border border-slate-200 p-8 shadow-xs space-y-6">
        <div>
          <h3 class="text-2xl font-bold text-slate-900 tracking-tight">The 100/100 Lighthouse Stack</h3>
          <p class="text-sm text-slate-600 mt-1">This website serves as a live proof-of-concept for minimal overhead static architecture.</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-2xl font-black text-emerald-600">100</p>
            <p class="text-xs font-semibold text-slate-600 mt-1">Performance</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-2xl font-black text-emerald-600">100</p>
            <p class="text-xs font-semibold text-slate-600 mt-1">Accessibility</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-2xl font-black text-emerald-600">100</p>
            <p class="text-xs font-semibold text-slate-600 mt-1">Best Practices</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-2xl font-black text-emerald-600">100</p>
            <p class="text-xs font-semibold text-slate-600 mt-1">SEO</p>
          </div>
        </div>

        <div class="prose-custom text-sm space-y-3">
          <p>
            Built using <strong>Astro 5</strong> in full static SSG mode, styled with <strong>Tailwind CSS v4</strong>, and hosted via multi-stage Docker builds on <strong>Coolify</strong> behind an optimized Alpine Nginx proxy with Gzip compression and long-lived asset caching.
          </p>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
