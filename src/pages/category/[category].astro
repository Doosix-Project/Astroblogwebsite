---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getAllPosts, slugify } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categoryMap = new Map<string, typeof posts>();

  posts.forEach((post) => {
    const slug = slugify(post.data.category);
    const existing = categoryMap.get(slug) || [];
    existing.push(post);
    categoryMap.set(slug, existing);
  });

  return Array.from(categoryMap.entries()).map(([slug, categoryPosts]) => ({
    params: { category: slug },
    props: {
      categoryName: categoryPosts[0].data.category,
      posts: categoryPosts,
    },
  }));
}

const { categoryName, posts } = Astro.props;
---

<BaseLayout
  title={`${categoryName} Articles & Architecture`}
  description={`Explore our in-depth engineering articles, tutorials, and benchmarks in ${categoryName}.`}
  image="/images/og-default.svg"
  category={categoryName}
>
  <!-- Category Page Header -->
  <section class="bg-white border-b border-slate-200/80 pt-10 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-blue-600 transition-colors">Categories</a>
        <span>/</span>
        <span class="text-slate-400 font-semibold">{categoryName}</span>
      </nav>

      <div class="max-w-3xl">
        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-blue-50 text-blue-700 border border-blue-200">
          Category Archive
        </span>
        <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          {categoryName}
        </h1>
        <p class="mt-2 text-slate-600 text-base">
          Showing {posts.length} {posts.length === 1 ? 'article' : 'articles'} filed under {categoryName}.
        </p>
      </div>

    </div>
  </section>

  <!-- Content Grid: 2 Columns + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- 2-Column Articles Grid (8 columns) -->
      <section class="lg:col-span-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {posts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      </section>

      <!-- Sidebar (4 columns) -->
      <div class="lg:col-span-4">
        <Sidebar showAuthor={true} />
      </div>

    </div>
  </div>
</BaseLayout>
