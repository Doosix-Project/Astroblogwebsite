---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page or guide you are looking for does not exist or has moved."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 font-mono font-black text-2xl mb-6 border border-blue-200">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
      Page Not Found
    </h1>
    <p class="mt-3 text-slate-600 text-base max-w-md mx-auto leading-relaxed">
      The technical article or resource you requested may have moved or been updated.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition-colors shadow-xs"
      >
        Back to Home
      </a>
      <a
        href="/blog"
        class="px-5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-bold text-xs hover:bg-slate-50 hover:text-blue-600 transition-colors"
      >
        Browse All Articles
      </a>
    </div>

    <!-- Quick topic shortcuts -->
    <div class="mt-12 pt-8 border-t border-slate-200 max-w-lg mx-auto">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Popular Categories</p>
      <div class="flex flex-wrap justify-center gap-2">
        <a href="/category/ai-llms" class="px-3 py-1.5 text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg text-slate-700 transition-colors">
          AI &amp; LLMs
        </a>
        <a href="/category/devops-cloud" class="px-3 py-1.5 text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg text-slate-700 transition-colors">
          DevOps &amp; Cloud
        </a>
        <a href="/category/open-source" class="px-3 py-1.5 text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg text-slate-700 transition-colors">
          Open Source
        </a>
        <a href="/category/architecture" class="px-3 py-1.5 text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg text-slate-700 transition-colors">
          Architecture
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
