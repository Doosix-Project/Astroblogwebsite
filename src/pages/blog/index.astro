---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getAllPosts, getCategoriesWithCount } from '../../utils/blog';

const allPosts = await getAllPosts();
const categories = await getCategoriesWithCount();
---

<BaseLayout
  title="All Articles // AI, DevOps & Open Source Engineering"
  description="Explore the complete collection of in-depth guides, architectural blueprints, and self-hosting tutorials."
  image="/images/og-default.svg"
>
  <!-- Page Header -->
  <section class="bg-white border-b border-slate-200/80 pt-10 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
          <span>Articles Archive</span>
          <span>•</span>
          <span>{allPosts.length} Technical Guides</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          All Articles &amp; Blueprints
        </h1>
        <p class="mt-3 text-slate-600 text-base sm:text-lg">
          Practical knowledge and system design teardowns for engineering teams.
        </p>
      </div>

      <!-- Live Search & Category Filter Toolbar -->
      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        
        <!-- Instant Search Input -->
        <div class="relative flex-1 max-w-md">
          <input
            id="article-search"
            type="search"
            placeholder="Search articles by title, tag, or topic..."
            aria-label="Search articles"
            class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
          <a
            href="/blog"
            class="px-3 py-1.5 text-xs font-bold rounded-lg bg-blue-600 text-white shadow-xs whitespace-nowrap"
          >
            All
          </a>
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-colors whitespace-nowrap"
            >
              {cat.name} ({cat.count})
            </a>
          ))}
        </div>

      </div>

    </div>
  </section>

  <!-- Main Content Layout: 2 Columns + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Article List (8 columns) -->
      <section class="lg:col-span-8" aria-label="Article Listing">
        
        <!-- Live Articles Count or Empty state -->
        <div id="no-results" class="hidden py-16 text-center bg-white rounded-2xl border border-slate-200 p-8">
          <p class="text-base font-bold text-slate-800">No matching articles found</p>
          <p class="text-xs text-slate-500 mt-1">Try searching for keywords like "Coolify", "Docker", "AI", or "Kubernetes".</p>
        </div>

        <div id="articles-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {allPosts.map((post) => (
            <div
              class="article-item"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-category={post.data.category.toLowerCase()}
              data-tags={post.data.tags.join(' ').toLowerCase()}
            >
              <ArticleCard post={post} />
            </div>
          ))}
        </div>

      </section>

      <!-- Sidebar (4 columns) -->
      <div class="lg:col-span-4">
        <Sidebar showAuthor={false} />
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('article-search');
  const items = document.querySelectorAll('.article-item');
  const noResults = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const cat = item.getAttribute('data-category') || '';
        const tags = item.getAttribute('data-tags') || '';

        const matches = !q || title.includes(q) || desc.includes(q) || cat.includes(q) || tags.includes(q);

        if (matches) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    });
  }
</script>
